  "formula_contract": {
    "beta_deg": "90 - alpha_deg",
    "baseline_mm": "v_mm * tan(alpha_deg)",
    "half_sensor_mm": "sensor_length_mm / 2",
    "width_mm": "baseline_mm + half_sensor_mm",
    "rear_mm": "v_mm - d_mm",
    "fp_mm": "baseline_mm * cos(beta_deg)",
    "lo_mm": "v_mm * cos(alpha_deg)",
    "total_mm": "fp_mm + lo_mm",
    "ray_intercept_s_mm": "half_sensor_mm * lo_mm * sin(beta_deg) / (fp_mm * sin(alpha_deg) - half_sensor_mm * sin(alpha_deg + beta_deg))",
    "f_derived_mm": "1 / (1 / lo_mm + 1 / fp_mm)",
    "alpha_equation_residual": "sin(alpha_deg)^2 * cos(alpha_deg) - focal_length_literal_mm / v_mm"
  },
